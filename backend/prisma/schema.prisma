generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int    @id @default(autoincrement())
  firstName       String
  lastName        String
  name            String
  email           String @unique
  mobile          String
  password        String
  confirmPassword String
}

model History {
  id                  String   @id
  dish_name           String
  calories_per_serving Int
  servings            Int
  total_calories      Int
  time                String 
  timestamp           DateTime @default(now())
  email               String
}
